From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Perttu Pohjonen <perttu.pohjonen@jolla.com>
Date: Sat, 24 Oct 2026 12:00:00 +0300
Subject: [PATCH] Stop the keypad keys repeating

On a 12-key keypad a held key is a long press: holding 1 calls voicemail and
holding * types +. Auto-repeat turned every such hold into a row of digits,
so mark the digits, * and # as non-repeating in the jolla:keypad option.
---
 symbols/jolla_vndr/sbj | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/symbols/jolla_vndr/sbj b/symbols/jolla_vndr/sbj
--- a/symbols/jolla_vndr/sbj
+++ b/symbols/jolla_vndr/sbj
@@ -65,10 +65,23 @@
 // 12-key keypad: KEY_NUMERIC_STAR (522) and KEY_NUMERIC_POUND (523). Selected
 // as the option jolla:keypad so it is appended after inet(evdev), which binds
 // them to XF86NumericStar and XF86NumericPound that Qt cannot use.
+// A held key on such a keypad is a long press, so none of its keys repeat.
 partial hidden alphanumeric_keys
 xkb_symbols "keypad" {
     key <I530>  { [     asterisk                                                        ] };
     key <I531>  { [     numbersign                                                      ] };
+    key <AE01>  { repeat = False };
+    key <AE02>  { repeat = False };
+    key <AE03>  { repeat = False };
+    key <AE04>  { repeat = False };
+    key <AE05>  { repeat = False };
+    key <AE06>  { repeat = False };
+    key <AE07>  { repeat = False };
+    key <AE08>  { repeat = False };
+    key <AE09>  { repeat = False };
+    key <AE10>  { repeat = False };
+    key <I530>  { repeat = False };
+    key <I531>  { repeat = False };
 };
 
 // The Callback's three function keys and the button on its back emit KEY_F21
